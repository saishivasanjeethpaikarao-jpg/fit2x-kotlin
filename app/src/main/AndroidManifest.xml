<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Step counting -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- Reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network (Firebase, food AI) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Barcode scanner (diet tracker) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Health Connect visibility (required on Android 14+ for SDK status checks) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".Fit2xApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FIT2X">

        <!-- Disable WorkManager auto-init at startup (it initialises via
             androidx.startup before Application.onCreate). The app only uses
             WorkManager as a fallback for reminders, so on-demand init is safe.
             Fit2xApplication implements Configuration.Provider for lazy init. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- DIAGNOSTIC BUILD ONLY: installs the crash catcher before
             Firebase/WorkManager providers initialise (they run before
             Application.onCreate). initOrder 100 = first. -->
        <provider
            android:name=".CrashCatcherProvider"
            android:authorities="${applicationId}.crashcatcher"
            android:exported="false"
            android:initOrder="100" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FIT2X">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Barcode scanner for the diet tracker (portrait, no history). -->
        <activity
            android:name=".diet.BarcodeScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.FIT2X" />

        <!-- Re-register reminders after device reboot (exact alarms don't survive it) -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Fires exact reminder alarms; re-arms the next day after each firing -->
        <receiver
            android:name=".notifications.AlarmReceiver"
            android:exported="false" />

    </application>
</manifest>
